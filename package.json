{
  "name": "portal-irmao-vl6",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.16.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:e2e": "firebase emulators:exec --project demo-vl6 --only auth,firestore \"bash scripts/run-e2e.sh\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "firebase-tools": "^15.25.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,md,json,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "zod": "^3.24.1"
    },
    "patchedDependencies": {
      "pdfjs-dist@5.4.296": "patches/pdfjs-dist@5.4.296.patch"
    }
  }
}
