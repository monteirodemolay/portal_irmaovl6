# Firebase client SDK (público — exposto ao browser, ver docs/architecture/07)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-only — nunca prefixar com NEXT_PUBLIC_)
# Deixe em branco em produção no Firebase App Hosting/Cloud Run: usa
# Application Default Credentials automaticamente (ver packages/infra/src/firebase/admin-app.ts).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Protege as rotas /api/cron/* (Vercel Cron — substituem Cloud Functions
# agendadas, sem plano Blaze). A Vercel injeta automaticamente
# "Authorization: Bearer $CRON_SECRET" nas chamadas de cron quando esta env
# var está configurada — gere um valor aleatório qualquer.
CRON_SECRET=

# Vercel Blob — storage de binários (Arquivos, Biblioteca, Galeria, fotos de
# Irmão, backups). Substituiu o Firebase Storage (ver
# packages/infra/src/vercel/blob-storage-adapter.ts). Crie um Blob Store em
# Vercel → Storage → Blob e copie o token gerado (ou rode `vercel env pull`
# num projeto já conectado). Sem esta variável, todo upload falha.
BLOB_READ_WRITE_TOKEN=
