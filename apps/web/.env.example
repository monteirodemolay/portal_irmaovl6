# Firebase client SDK (público — exposto ao browser, ver docs/architecture/07)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-only — nunca prefixar com NEXT_PUBLIC_)
# Deixe em branco em produção no Firebase App Hosting/Cloud Run: usa
# Application Default Credentials automaticamente (ver packages/infra/src/firebase/admin-app.ts).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Protege as rotas /api/cron/* (Vercel Cron — substituem Cloud Functions
# agendadas, sem plano Blaze). A Vercel injeta automaticamente
# "Authorization: Bearer $CRON_SECRET" nas chamadas de cron quando esta env
# var está configurada — gere um valor aleatório qualquer.
CRON_SECRET=

# Vercel Blob — storage de binários (Arquivos, Biblioteca, Galeria, fotos de
# Irmão, backups). Substituiu o Firebase Storage (ver
# packages/infra/src/vercel/blob-storage-adapter.ts). Crie um Blob Store em
# Vercel → Storage → Blob e copie o token gerado (ou rode `vercel env pull`
# num projeto já conectado). Sem esta variável, todo upload falha.
BLOB_READ_WRITE_TOKEN=

# Integração Google Agenda (Minha Agenda) — OAuth2 + Calendar API v3, ver
# packages/infra/src/google/google-calendar-service.ts. Crie um projeto no
# Google Cloud Console, habilite a Calendar API e configure uma tela de
# consentimento OAuth; o Client ID/Secret vêm das credenciais OAuth 2.0
# criadas lá. Sem estas variáveis, a integração fica no estado "não
# configurada" — a Minha Agenda continua funcionando normalmente só com
# VL6 + compromissos pessoais.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL de callback cadastrada no Google Cloud Console — precisa bater
# exatamente com apps/web/src/app/api/integrations/google-calendar/callback/route.ts
# (ex.: https://portal.vl6.com.br/api/integrations/google-calendar/callback).
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.events
# Segredo usado para cifrar (AES-256-GCM) os tokens OAuth do Irmão antes de
# persistir no Firestore e para assinar (HMAC) o `state` do handshake OAuth
# — gere um valor aleatório longo qualquer. Nunca reaproveite este valor
# para outro propósito.
GOOGLE_TOKEN_ENCRYPTION_KEY=
