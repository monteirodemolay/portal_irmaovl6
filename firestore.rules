rules_version = '2';

// Estratégia completa em docs/architecture/03-modelo-dados.md §3.4.
// `tenantId` e `permissions` vêm de Custom Claims (docs/architecture/07 §7.3),
// nunca lidos de outro documento Firestore — evita uma leitura extra por
// avaliação de regra.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function tokenTenantId() {
      return request.auth.token.tenantId;
    }

    function tokenPermissions() {
      return request.auth.token.permissions;
    }

    // Administrador Geral (`super_admin`, docs/architecture/08 §8.3) — não
    // pertence a nenhuma Loja, vive sob o tenantId sentinela `platform`
    // (`PLATFORM_TENANT_ID` em packages/shared). Cross-tenant por definição.
    function isSuperAdmin() {
      return isSignedIn() && tokenTenantId() == 'platform';
    }

    function sameTenant(data) {
      return isSignedIn() && (data.tenantId == tokenTenantId() || isSuperAdmin());
    }

    // `perm` no formato "<recurso>:<acao>" — concede também se o papel tiver
    // "<recurso>:manage" (implica todas as ações sobre o recurso).
    function hasPermission(perm) {
      return isSignedIn() &&
        (perm in tokenPermissions() || (perm.split(':')[0] + ':manage') in tokenPermissions());
    }

    function isOwner(data, field) {
      return isSignedIn() && data[field] == request.auth.uid;
    }

    // Central dos Irmãos VL6 — as 3 coleções guardam `memberId` (id do
    // documento `Member`), não um uid direto, então `isOwner()` não serve
    // (ele compara `data[field] == request.auth.uid` literalmente). Resolve
    // `memberId → userId` com uma leitura extra — mesmo trade-off já aceito
    // em `withAudit` (packages/infra) por não termos Cloud Functions.
    function isSelfCentralProfile(data) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/members/$(data.memberId)).data.userId == request.auth.uid;
    }

    function notSoftDeleted(data) {
      return data.deletedAt == null;
    }

    // ---------------------------------------------------------------
    // Tenancy
    // ---------------------------------------------------------------
    match /tenants/{tenantId} {
      allow read: if isSignedIn() && (tokenTenantId() == tenantId || isSuperAdmin());
      // Criar uma Loja é uma operação do Administrador Geral, não de
      // `tenant:manage` — todo Administrador de Loja já tem `tenant:manage`
      // de fábrica, e `hasPermission` trata "<recurso>:manage" como
      // implicando "<recurso>:create" (ver função acima), então checar só a
      // permissão deixaria qualquer Administrador de Loja criar novas Lojas.
      // Replica a mesma regra de `requirePlatformAdmin()` do backend
      // (packages/domain/src/shared/auth-context.ts).
      allow create: if isSuperAdmin();
      allow update: if sameTenant(resource.data) && hasPermission('tenant:manage');
      allow delete: if false; // soft delete apenas, via update
    }

    match /tenantDomainVerifications/{domain} {
      allow read: if sameTenant(resource.data) && hasPermission('tenant:manage');
      allow create: if sameTenant(request.resource.data) && hasPermission('tenant:manage');
      allow update: if sameTenant(resource.data) && hasPermission('tenant:manage');
      allow delete: if false;
    }

    match /tenantBranding/{id} {
      allow read: if sameTenant(resource.data) || true; // branding é necessário antes do login (layout raiz)
      allow write: if sameTenant(resource.data) && hasPermission('branding:manage');
    }

    match /tenantSettings/{id} {
      allow read: if sameTenant(resource.data) || true; // idem — necessário para o site público
      allow write: if sameTenant(resource.data) && hasPermission('tenant:manage');
    }

    // ---------------------------------------------------------------
    // Identity & Access
    // ---------------------------------------------------------------
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || (sameTenant(resource.data) && hasPermission('user:read')));
      allow create, update: if sameTenant(request.resource.data) && hasPermission('user:manage');
      allow delete: if false;
    }

    match /roles/{id} {
      allow read: if sameTenant(resource.data) && isSignedIn();
      allow write: if sameTenant(request.resource.data) && hasPermission('role:manage')
        && (resource == null || resource.data.sistemico == false || request.resource.data.permissoes == resource.data.permissoes);
    }

    // API Keys — sempre criadas/lidas via Admin SDK (Server Actions), nunca
    // pelo client direto; regra aqui é só defesa em profundidade.
    match /apiKeys/{id} {
      allow read: if sameTenant(resource.data) && hasPermission('tenant:manage');
      allow create: if sameTenant(request.resource.data) && hasPermission('tenant:manage');
      allow update: if sameTenant(resource.data) && hasPermission('tenant:manage');
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // Membership
    // ---------------------------------------------------------------
    match /members/{id} {
      allow read: if sameTenant(resource.data) && hasPermission('member:read');
      allow create: if sameTenant(request.resource.data) && hasPermission('member:create');
      allow update: if sameTenant(resource.data) &&
        (hasPermission('member:update') || isOwner(resource.data, 'userId'));
      allow delete: if false;
    }

    match /memberPositionHistory/{id} {
      allow read: if sameTenant(resource.data) && hasPermission('member:read');
      allow write: if sameTenant(request.resource.data) && hasPermission('member:update');
    }

    // ---------------------------------------------------------------
    // Governance
    // ---------------------------------------------------------------
    match /boardTerms/{id} {
      allow read: if sameTenant(resource.data) && hasPermission('boardTerm:read');
      allow write: if sameTenant(request.resource.data) && hasPermission('boardTerm:manage');
    }

    match /boardPositionAssignments/{id} {
      allow read: if sameTenant(resource.data) && hasPermission('boardTerm:read');
      allow write: if sameTenant(request.resource.data) && hasPermission('boardTerm:manage');
    }

    match /committees/{id} {
      allow read: if sameTenant(resource.data) && hasPermission('committee:read');
      allow write: if sameTenant(request.resource.data) && hasPermission('committee:manage');
    }

    // ---------------------------------------------------------------
    // Document Management & Library
    // ---------------------------------------------------------------
    match /fileCategories/{id} {
      allow read: if sameTenant(resource.data) && hasPermission('file:read');
      allow write: if sameTenant(request.resource.data) && hasPermission('file:manage');
    }

    match /files/{id} {
      allow read: if sameTenant(resource.data) && hasPermission('file:read') && (resource.data.publicado == true || hasPermission('file:manage'));
      allow create, update: if sameTenant(request.resource.data) && hasPermission('file:create');
      allow delete: if false;
    }

    match /libraryCategories/{id} {
      allow read: if sameTenant(resource.data) && hasPermission('libraryItem:read');
      allow write: if sameTenant(request.resource.data) && hasPermission('libraryItem:manage');
    }

    match /libraryItems/{id} {
      allow read: if sameTenant(resource.data) && hasPermission('libraryItem:read');
      allow write: if sameTenant(request.resource.data) && hasPermission('libraryItem:manage');
    }

    match /libraryFavorites/{id} {
      allow read, write: if isSignedIn() && isOwner(resource.data, 'userId');
      allow create: if isSignedIn() && isOwner(request.resource.data, 'userId') && sameTenant(request.resource.data);
    }

    // ---------------------------------------------------------------
    // Agenda
    // ---------------------------------------------------------------
    match /events/{id} {
      allow read: if sameTenant(resource.data) && hasPermission('event:read');
      allow write: if sameTenant(request.resource.data) && hasPermission('event:manage');
    }

    match /eventAttendance/{id} {
      allow read: if sameTenant(resource.data) && (hasPermission('event:read') || isOwner(resource.data, 'memberId'));
      allow create, update: if sameTenant(request.resource.data) &&
        (hasPermission('event:manage') || isOwner(request.resource.data, 'memberId'));
    }

    // Compromisso privado do Irmão — nunca visível a administradores/outros
    // Irmãos, mesmo padrão de `libraryFavorites`/`notificationPreferences`.
    match /personalEvents/{id} {
      allow read, write: if isSignedIn() && isOwner(resource.data, 'userId');
      allow create: if isSignedIn() && isOwner(request.resource.data, 'userId') && sameTenant(request.resource.data);
    }

    // "Minhas tarefas" e "Minhas anotações" da Minha Agenda — mesmo padrão de `personalEvents`.
    match /personalTasks/{id} {
      allow read, write: if isSignedIn() && isOwner(resource.data, 'userId');
      allow create: if isSignedIn() && isOwner(request.resource.data, 'userId') && sameTenant(request.resource.data);
    }

    match /personalNotes/{id} {
      allow read, write: if isSignedIn() && isOwner(resource.data, 'userId');
      allow create: if isSignedIn() && isOwner(request.resource.data, 'userId') && sameTenant(request.resource.data);
    }

    // ---------------------------------------------------------------
    // Content
    // ---------------------------------------------------------------
    match /news/{id} {
      allow read: if sameTenant(resource.data) && hasPermission('news:read') && (resource.data.publicado == true || hasPermission('news:manage'));
      allow write: if sameTenant(request.resource.data) && hasPermission('news:manage');
    }

    match /newsComments/{id} {
      allow read: if sameTenant(resource.data) && hasPermission('news:read');
      allow create: if sameTenant(request.resource.data) && hasPermission('news:read') && isOwner(request.resource.data, 'autorId');
      allow update, delete: if sameTenant(resource.data) && hasPermission('news:manage');
    }

    match /announcements/{id} {
      allow read: if sameTenant(resource.data) && hasPermission('announcement:read') && (resource.data.publicado == true || hasPermission('announcement:manage'));
      allow write: if sameTenant(request.resource.data) && hasPermission('announcement:manage');
    }

    match /inspirationalQuotes/{id} {
      allow read: if sameTenant(resource.data) && hasPermission('quote:read') && (resource.data.ativa == true || hasPermission('quote:manage'));
      allow write: if sameTenant(request.resource.data) && hasPermission('quote:manage');
    }

    // ---------------------------------------------------------------
    // Gallery
    // ---------------------------------------------------------------
    match /galleryAlbums/{id} {
      allow read: if sameTenant(resource.data) && hasPermission('gallery:read');
      allow write: if sameTenant(request.resource.data) && hasPermission('gallery:manage');
    }

    match /galleryMedia/{id} {
      allow read: if sameTenant(resource.data) && hasPermission('gallery:read');
      allow write: if sameTenant(request.resource.data) && hasPermission('gallery:manage');
    }

    // ---------------------------------------------------------------
    // Acervo VL6 — Etapa 2 (docs/architecture/11-acervo-vl6.md §11.6)
    // ---------------------------------------------------------------
    match /archiveCollections/{id} {
      allow read: if sameTenant(resource.data) && hasPermission('archiveCollection:read') && (resource.data.publicado == true || hasPermission('archiveCollection:manage'));
      allow create, update: if sameTenant(request.resource.data) && hasPermission('archiveCollection:create');
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // Acervo VL6 — Estágio 5, Constelação da Memória e Exposições
    // Virtuais (docs/architecture/11-acervo-vl6.md §11.6d)
    // ---------------------------------------------------------------
    match /archiveRelations/{id} {
      allow read: if sameTenant(resource.data) && hasPermission('archiveRelation:read');
      allow create, update: if sameTenant(request.resource.data) && hasPermission('archiveRelation:create');
      allow delete: if false;
    }
    match /archiveExhibitions/{id} {
      allow read: if sameTenant(resource.data) && hasPermission('archiveExhibition:read') && (resource.data.publicado == true || hasPermission('archiveExhibition:manage'));
      allow create, update: if sameTenant(request.resource.data) && hasPermission('archiveExhibition:create');
      allow delete: if false;
    }
    // Fichas de catalogação (docs/architecture/11-acervo-vl6.md §11.6e) —
    // camada aditiva que só referencia um item já existente por `origemId`,
    // nunca migra/substitui a coleção de origem.
    match /archiveCatalogEntries/{id} {
      allow read: if sameTenant(resource.data) && hasPermission('archiveCatalog:read') && (resource.data.publicado == true || hasPermission('archiveCatalog:manage'));
      allow create, update: if sameTenant(request.resource.data) && hasPermission('archiveCatalog:manage');
      allow delete: if false;
    }
    // Contribuições dos Irmãos (Estágio 8, §11.6g) — envio e moderação
    // acontecem exclusivamente via Server Action com Admin SDK (nunca pelo
    // client direto, mesmo padrão de `auditLogs`): enviar é ação pessoal
    // sem permissão de recurso, moderar exige `archiveContribution:manage`.
    match /archiveContributions/{id} {
      allow read: if sameTenant(resource.data) && hasPermission('archiveContribution:manage');
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // Acervo VL6 — Fase 1 da Fundação (docs/architecture/11-acervo-vl6.md
    // §11.5): `archiveItems`, `mediaAssets` e o vínculo entre eles
    // (`archiveMedia`). Mesmo padrão de `archiveCollections` acima:
    // leitura pública quando publicado, ou com permissão de gestão;
    // nunca `allow delete` — só soft delete via update (`deletedAt`).
    // ---------------------------------------------------------------
    match /archiveItems/{id} {
      allow read: if sameTenant(resource.data) && hasPermission('archiveItem:read') && (resource.data.publicacaoStatus == 'publicado' || hasPermission('archiveItem:manage'));
      allow create, update: if sameTenant(request.resource.data) && hasPermission('archiveItem:create');
      allow delete: if false;
    }
    match /mediaAssets/{id} {
      allow read: if sameTenant(resource.data) && hasPermission('mediaAsset:read');
      allow create, update: if sameTenant(request.resource.data) && hasPermission('mediaAsset:create');
      allow delete: if false;
    }
    match /archiveMedia/{id} {
      allow read: if sameTenant(resource.data) && hasPermission('archiveMedia:read') && (resource.data.publicacaoStatus == 'publicado' || hasPermission('archiveMedia:manage'));
      allow create, update: if sameTenant(request.resource.data) && hasPermission('archiveMedia:create');
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // Audit — write exclusivamente via Admin SDK (ignora Security Rules),
    // dentro da própria Server Action que faz a escrita de negócio
    // (withAudit, packages/infra), nunca pelo client. Ver docs/architecture
    // /06 §6.7.
    // ---------------------------------------------------------------
    match /auditLogs/{id} {
      allow read: if sameTenant(resource.data) && hasPermission('auditLog:read');
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // Notification — sempre privado ao próprio destinatário
    // ---------------------------------------------------------------
    match /notifications/{id} {
      allow read, update: if isSignedIn() && isOwner(resource.data, 'destinatarioId');
      allow create, delete: if false; // criadas via Cloud Function
    }

    match /notificationPreferences/{id} {
      allow read, write: if isSignedIn() && isOwner(resource.data, 'userId');
    }

    // ---------------------------------------------------------------
    // Integrations — Google Calendar (sempre privado ao próprio usuário;
    // tokens só chegam aqui já cifrados pelo backend via `ITokenCipher`)
    // ---------------------------------------------------------------
    match /googleCalendarConnections/{id} {
      allow read, write: if isSignedIn() && isOwner(resource.data, 'userId');
    }

    match /googleEventSyncLinks/{id} {
      allow read, write: if isSignedIn() && isOwner(resource.data, 'userId');
    }

    match /googleCalendarEvents/{id} {
      allow read, write: if isSignedIn() && isOwner(resource.data, 'userId');
    }

    // ---------------------------------------------------------------
    // Public Site (CMS institucional)
    // ---------------------------------------------------------------
    match /publicPages/{id} {
      allow read: if resource.data.publicado == true || (sameTenant(resource.data) && hasPermission('tenant:manage'));
      allow write: if sameTenant(request.resource.data) && hasPermission('tenant:manage');
    }

    match /links/{id} {
      allow read: if sameTenant(resource.data) && hasPermission('link:read');
      allow write: if sameTenant(request.resource.data) && hasPermission('link:create');
    }

    // ---------------------------------------------------------------
    // Central dos Irmãos VL6 — diretório institucional privado e
    // voluntário. Leitura em client direto não é o caminho pretendido
    // (sempre via Server Action, que já filtra campo a campo pelo Use
    // Case) — estas regras são defesa em profundidade, não o canal real.
    // ---------------------------------------------------------------
    match /memberCentralProfiles/{id} {
      allow read: if sameTenant(resource.data) &&
        (hasPermission('memberDirectory:read') || hasPermission('memberCentral:manage'));
      // Admin pode corrigir conteúdo administrativamente (memberCentral:manage),
      // mas nunca decide visibilidade — isso vive só em publicationSettings.
      allow create, update: if sameTenant(request.resource.data) &&
        (isSelfCentralProfile(request.resource.data) || hasPermission('memberCentral:manage'));
      allow delete: if false;
    }

    match /publicationSettings/{id} {
      allow read: if sameTenant(resource.data) &&
        (hasPermission('memberDirectory:read') || hasPermission('memberCentral:manage'));
      // Só o titular cria (nunca um admin publica em nome de alguém).
      allow create: if sameTenant(request.resource.data) && isSelfCentralProfile(request.resource.data);
      // Duas metades que nunca se misturam numa mesma escrita: o titular
      // mexe em profilePublished/blocks/contacts/externalLinks mas nunca em
      // suspendedAt/By/Reason; a Administração (memberCentral:manage) é o
      // oposto — só pode suspender/reativar, nunca ligar visibilidade.
      allow update: if sameTenant(request.resource.data) && (
        (isSelfCentralProfile(request.resource.data) &&
          request.resource.data.suspendedAt == resource.data.suspendedAt &&
          request.resource.data.suspendedBy == resource.data.suspendedBy &&
          request.resource.data.suspendedReason == resource.data.suspendedReason) ||
        (hasPermission('memberCentral:manage') &&
          request.resource.data.profilePublished == resource.data.profilePublished &&
          request.resource.data.blocks == resource.data.blocks &&
          request.resource.data.contacts == resource.data.contacts &&
          request.resource.data.externalLinks == resource.data.externalLinks)
      );
      allow delete: if false;
    }

    match /publicationConsents/{id} {
      allow read: if sameTenant(resource.data) &&
        (isSelfCentralProfile(resource.data) || hasPermission('memberCentral:manage'));
      allow create: if sameTenant(request.resource.data) && isSelfCentralProfile(request.resource.data);
      allow update, delete: if false; // append-only, igual auditLogs
    }
  }
}
